                {{ paper(entry.id, entry.authors, entry.title.title, entry.source.source, entry.doi, entry.arxiv, entry.abstract, entry.bibtex, entry['zbmath_url'], pdf) }}
                {% endfilter -%}
            {% if count.update({'counter': count.counter + 1}) %} {% endif %}
            {% endif -%}
            {% endfor %}
            .container-fluid
                h3.mt-5.mb-3.text-center 
                    .bi.bi-journal-check &nbsp; Papers
                .scrolling-wrapper.row.flex-row.flex-nowrap.px-3.px-sm-5.mt-4.pb-4.pt-2(style="overflow-x: auto; overflow-y: hidden; -webkit-mask: linear-gradient(90deg,#0000,#000 5% 95%,#0000);")
            {% for entry in biblio %}
