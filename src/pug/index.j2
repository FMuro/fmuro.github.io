            {% else %}
            {% set pdf = ('a.btn.btn-xs(href="' ~ datos.open[entry.id] ~ '") PDF') %}
            {% endif %}
            {% else %}
            {% set pdf = '' %}
            {% endif %}
            {% for name in entry.author %}
            {% if name.family in datos.coauthors.keys() %}
            {% do name.update({'url': datos.coauthors[name.family]}) %}
            {% endif %}
            {% endfor %}
                {% filter indent(width=20) %}
                {{ paper(entry.id, entry.authors, entry.title.title, entry.source.source, entry.doi, entry.arxiv, entry.abstract, entry.bibtex, entry['zbmath_url'], pdf) }}
