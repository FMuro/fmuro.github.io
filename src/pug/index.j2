        script.
            function myFunction(myInput) {
                let text = myInput.textContent;
                // Replace '&nbsp;&nbsp;&nbsp;&nbsp;' (4 non-breaking spaces) with a new line
                text = text.replace(/\u00a0{4}/g, '\n');
                navigator.clipboard.writeText(text);
                // Find the button that triggered this function
                let btn = null;
                // Try to get the button from the event if possible
                if (window.event && window.event.target) {
                    btn = window.event.target;
                } else {
                    // fallback: try to find the closest button
                    btn = myInput.closest('.modal').querySelector('.btn-info, .btn-secondary');
                }
                if (btn) {
                    // Change color to secondary
                    btn.classList.remove('btn-info');
                    btn.classList.add('btn-secondary');
                    // Show tooltip
                    const original = btn.getAttribute('data-bs-original-title') || btn.title || '';
                    btn.setAttribute('data-bs-original-title', original); // store original
                    btn.setAttribute('title', 'Copied!');
                    // Bootstrap 5 tooltip
                    if (window.bootstrap && bootstrap.Tooltip) {
                        let tooltip = bootstrap.Tooltip.getInstance(btn);
                        if (!tooltip) {
                            tooltip = new bootstrap.Tooltip(btn);
                        }
                        tooltip.setContent({ '.tooltip-inner': 'Copied!' });
                        tooltip.show();
                        // Tooltip will stay until modal is closed
                    } else {
                        // fallback: native tooltip
                        btn.setAttribute('title', 'Copied!');
                    }
                    // Hide tooltip and reset button when modal is closed
                    const modal = myInput.closest('.modal');
                    if (modal) {
                        modal.addEventListener('hidden.bs.modal', function handler() {
                            // Reset button color
                            btn.classList.remove('btn-secondary');
                            btn.classList.add('btn-info');
                            // Restore original tooltip
                            const original = btn.getAttribute('data-bs-original-title') || '';
                            btn.setAttribute('title', original);
                            if (window.bootstrap && bootstrap.Tooltip) {
                                let tooltip = bootstrap.Tooltip.getInstance(btn);
                                if (tooltip) tooltip.hide();
                            }
                            modal.removeEventListener('hidden.bs.modal', handler);
                        });
                    }
                }
            }

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')

        // SimpleLightbox plugin JS
